\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The GNOmE pipeline.} A trained model (MLP or transformer) is differentiated blockwise to obtain mean-absolute Jacobians; per-layer relative thresholding produces a layered circuit graph; the graph is measured with explicability metrics and, when the true circuit is known by construction, scored for recovery; graph networks learn to read roles and metrics directly from the graph. All numbers in this paper come from committed result JSONs (\texttt  {results/*.json}).}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{3}{\textbf {The GNOmE pipeline.} A trained model (MLP or transformer) is differentiated blockwise to obtain mean-absolute Jacobians; per-layer relative thresholding produces a layered circuit graph; the graph is measured with explicability metrics and, when the true circuit is known by construction, scored for recovery; graph networks learn to read roles and metrics directly from the graph. All numbers in this paper come from committed result JSONs (\texttt {results/*.json})}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Explicability metrics and recovery on the base benchmark} (all values from \texttt  {results/benchmark\_cpu.json}; boolean rows are means over 3 seeds; MLP width 32; relative threshold 0.5).}}{3}{table.caption.2}\protected@file@percent }
\newlabel{tab:benchmark}{{1}{3}{\textbf {Explicability metrics and recovery on the base benchmark} (all values from \texttt {results/benchmark\_cpu.json}; boolean rows are means over 3 seeds; MLP width 32; relative threshold 0.5)}{table.caption.2}{}}
