\citation{nanda2022addition}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Reading transfers across sizes, not architectures.} A GNN trained on 7-input MLP circuit graphs reads depth roles on 9-input graphs (never seen) at 0.96 macro-F1, while the feature-only baseline saturates at 0.76. On transformer graphs the same reading collapses to chance for every readout (control).}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:transfer}{{4}{7}{\textbf {Reading transfers across sizes, not architectures.} A GNN trained on 7-input MLP circuit graphs reads depth roles on 9-input graphs (never seen) at 0.96 macro-F1, while the feature-only baseline saturates at 0.76. On transformer graphs the same reading collapses to chance for every readout (control)}{figure.caption.7}{}}
