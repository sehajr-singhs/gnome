\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {GNOmE and attribution patching disagree.} Normalized importance scores per layer on GPT-2 Small. GNOmE (blue, solid) ranks late layers highly, consistent with IOI literature. Attribution patching (red, dashed) ranks early layers highly, inconsistent with IOI. Spearman $\rho = -0.544$ ($p = 0.006$). The green shaded region marks the known IOI circuit location (L8--L10).}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:disagreement}{{4}{6}{\textbf {GNOmE and attribution patching disagree.} Normalized importance scores per layer on GPT-2 Small. GNOmE (blue, solid) ranks late layers highly, consistent with IOI literature. Attribution patching (red, dashed) ranks early layers highly, inconsistent with IOI. Spearman $\rho = -0.544$ ($p = 0.006$). The green shaded region marks the known IOI circuit location (L8--L10)}{figure.4}{}}
