\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Extracted Computation Graph (GPT-2 Small, $\tau =0.3$).} Nodes are attention heads colored by their known IOI role: red = duplicate token heads (L8\_H0, L9\_H6, L9\_H9), orange = S-inhibition (L8\_H1), green = name mover (L10\_H0). Edge thickness reflects Jacobian-weighted contribution strength. The zero-query score recovers 3/7 known component classes from a single forward pass with no interventions.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:circuit}{{2}{5}{\textbf {Extracted Computation Graph (GPT-2 Small, $\tau =0.3$).} Nodes are attention heads colored by their known IOI role: red = duplicate token heads (L8\_H0, L9\_H6, L9\_H9), orange = S-inhibition (L8\_H1), green = name mover (L10\_H0). Edge thickness reflects Jacobian-weighted contribution strength. The zero-query score recovers 3/7 known component classes from a single forward pass with no interventions}{figure.caption.2}{}}
