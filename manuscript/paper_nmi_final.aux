\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {GNOmE Architecture Overview.} The pipeline extracts a computation graph from a single forward pass (Step 1--2), then reads it with a GNN to predict importance (Step 3--4). The key advantage is $O(1)$ query complexity versus $O(N^2)$ for path patching and $O(N^2 \cdot T)$ for ACDC. The convergent discovery box at bottom highlights that GNOmE and Anthropic's Circuit Tracing independently arrived at graph-based representations of neural computation.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{2}{\textbf {GNOmE Architecture Overview.} The pipeline extracts a computation graph from a single forward pass (Step 1--2), then reads it with a GNN to predict importance (Step 3--4). The key advantage is $O(1)$ query complexity versus $O(N^2)$ for path patching and $O(N^2 \cdot T)$ for ACDC. The convergent discovery box at bottom highlights that GNOmE and Anthropic's Circuit Tracing independently arrived at graph-based representations of neural computation}{figure.caption.1}{}}
