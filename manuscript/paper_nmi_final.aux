\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Head-to-head comparison on GPT-2 Small.} (A) Spearman $\rho $ with ground truth. GNOmE is the only method with meaningful positive correlation. (B) Wall-clock extraction time. GNOmE runs 443$\times $ faster than attribution patching. (C) IOI circuit component recovery. GNOmE recovers 3/7 known components.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:head_to_head}{{3}{5}{\textbf {Head-to-head comparison on GPT-2 Small.} (A) Spearman $\rho $ with ground truth. GNOmE is the only method with meaningful positive correlation. (B) Wall-clock extraction time. GNOmE runs 443$\times $ faster than attribution patching. (C) IOI circuit component recovery. GNOmE recovers 3/7 known components}{figure.3}{}}
