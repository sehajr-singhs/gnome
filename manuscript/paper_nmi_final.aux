\@writefile{toc}{\contentsline {section}{\numberline {4}Experiments}{6}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Experimental Setup}{6}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Main Results: GNOmE Outperforms Path Patching}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {GNOmE vs.\ path patching.} (a) Per-model Pearson correlation with ground-truth zero-ablation importance. GNOmE achieves positive correlation on all 6 models; path patching is negative on 5 of 6. (b) Mean correlation across all methods. GNOmE ($r=0.748$) outperforms ACDC ($r=0.505$), attribution patching ($r=0.398$), and path patching ($r=-0.365$) while requiring only $O(1)$ queries.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:correlation}{{3}{6}{\textbf {GNOmE vs.\ path patching.} (a) Per-model Pearson correlation with ground-truth zero-ablation importance. GNOmE achieves positive correlation on all 6 models; path patching is negative on 5 of 6. (b) Mean correlation across all methods. GNOmE ($r=0.748$) outperforms ACDC ($r=0.505$), attribution patching ($r=0.398$), and path patching ($r=-0.365$) while requiring only $O(1)$ queries}{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Per-model correlation with ground-truth (zero-ablation) importance. Bold = best per row.}}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:main}{{1}{7}{Per-model correlation with ground-truth (zero-ablation) importance. Bold = best per row}{table.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Cross-Model Transfer}{7}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Cross-task transfer and query complexity.} (a) GNN cross-transfer matrix: IOI-trained GNN achieves $r=0.954$ on Induction models, and vice versa $r=0.963$. (b) Query complexity comparison: GNOmE requires 1 forward pass; path patching requires 8 (for our 2-layer models), ACDC requires $\sim $120 iterations.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:transfer}{{4}{7}{\textbf {Cross-task transfer and query complexity.} (a) GNN cross-transfer matrix: IOI-trained GNN achieves $r=0.954$ on Induction models, and vice versa $r=0.963$. (b) Query complexity comparison: GNOmE requires 1 forward pass; path patching requires 8 (for our 2-layer models), ACDC requires $\sim $120 iterations}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces GNN cross-model transfer performance. LOO = leave-one-out cross-validation.}}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:transfer}{{2}{7}{GNN cross-model transfer performance. LOO = leave-one-out cross-validation}{table.caption.6}{}}
