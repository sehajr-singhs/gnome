\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Circuit Discovery Correlation with Ground Truth.} GNOmE ($r = 0.748$) outperforms path patching ($r = -0.365$), ACDC ($r = 0.505$), and attribution patching ($r = 0.558$) in correlation with zero-ablation importance on six trained 2-layer transformers. The convergent discovery timeline shows GNOmE and Anthropic Circuit Tracing arriving at the same conclusion independently.}}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:correlation}{{1}{3}{\textbf {Circuit Discovery Correlation with Ground Truth.} GNOmE ($r = 0.748$) outperforms path patching ($r = -0.365$), ACDC ($r = 0.505$), and attribution patching ($r = 0.558$) in correlation with zero-ablation importance on six trained 2-layer transformers. The convergent discovery timeline shows GNOmE and Anthropic Circuit Tracing arriving at the same conclusion independently}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}IOI component recovery}{3}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces IOI Component Recovery on GPT-2 Small (156 units). Lower rank is better. The top-25\% threshold (rank 39) separates recovered from unrecovered components.}}{3}{table.caption.3}\protected@file@percent }
\newlabel{tab:ioi}{{1}{3}{IOI Component Recovery on GPT-2 Small (156 units). Lower rank is better. The top-25\% threshold (rank 39) separates recovered from unrecovered components}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Query complexity}{3}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Query Complexity Comparison.} GNOmE requires a single forward pass (O(1)) to discover circuits. Path patching requires O($N^2$) queries for $N$ components. ACDC requires O($N^2$) iterations. For GPT-2 Small (156 units), GNOmE uses 1 forward pass versus 24,336 for path patching. The efficiency advantage grows quadratically with model size.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:queries}{{2}{3}{\textbf {Query Complexity Comparison.} GNOmE requires a single forward pass (O(1)) to discover circuits. Path patching requires O($N^2$) queries for $N$ components. ACDC requires O($N^2$) iterations. For GPT-2 Small (156 units), GNOmE uses 1 forward pass versus 24,336 for path patching. The efficiency advantage grows quadratically with model size}{figure.caption.4}{}}
\citation{anthropic2025}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Cross-task transfer}{4}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Convergent Discovery Timeline.} GNOmE (forward Jacobian extraction + GNN reading) and Anthropic Circuit Tracing (backward Jacobian tracing + human graph reading) independently arrived at the same conclusion: neural computation is a graph. The convergence is methodological, not coincidental.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:convergent}{{3}{4}{\textbf {Convergent Discovery Timeline.} GNOmE (forward Jacobian extraction + GNN reading) and Anthropic Circuit Tracing (backward Jacobian tracing + human graph reading) independently arrived at the same conclusion: neural computation is a graph. The convergence is methodological, not coincidental}{figure.caption.5}{}}
