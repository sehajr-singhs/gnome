\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Circuit Discovery Correlation with Ground Truth.} GNOmE ($r = 0.748$) outperforms path patching ($r = -0.365$), ACDC ($r = 0.505$), and attribution patching ($r = 0.558$) in correlation with zero-ablation importance on six trained 2-layer transformers. Per-model correlations: GNOmE ranges from 0.617 to 0.847; path patching ranges from $-0.558$ to $+0.024$.}}{3}{figure.caption.2}\protected@file@percent }
