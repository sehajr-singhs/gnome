\@writefile{toc}{\contentsline {section}{\numberline {1}The problem is in the gradients, not the method}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {GNOmE succeeds where all gradient-based methods fail.} Spearman $\rho $ correlation with zero-ablation ground truth on GPT-2 Small. GNOmE achieves $\rho = 0.558$. Attribution patching achieves $\rho = -0.017$ (random noise). Anthropic's Circuit Tracing produces NaN for all 12 layers. Only GNOmE produces meaningful positive correlation.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:main}{{1}{2}{\textbf {GNOmE succeeds where all gradient-based methods fail.} Spearman $\rho $ correlation with zero-ablation ground truth on GPT-2 Small. GNOmE achieves $\rho = 0.558$. Attribution patching achieves $\rho = -0.017$ (random noise). Anthropic's Circuit Tracing produces NaN for all 12 layers. Only GNOmE produces meaningful positive correlation}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Query complexity comparison.} GNOmE requires exactly 1 forward pass regardless of model size. Path patching requires $O(N^2)$ interventions. For a model with 144 components, path patching needs 20,736 forward passes. GNOmE needs 1.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:query}{{2}{3}{\textbf {Query complexity comparison.} GNOmE requires exactly 1 forward pass regardless of model size. Path patching requires $O(N^2)$ interventions. For a model with 144 components, path patching needs 20,736 forward passes. GNOmE needs 1}{figure.2}{}}
