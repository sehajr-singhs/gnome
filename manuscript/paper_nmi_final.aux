\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}GPT-2 Scale Extraction and Zero-Query Validation}{8}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {GPT-2 Small results.} (a) IOI component recovery: zero-query score recovers duplicate-token heads (L8\_H0, L9\_H6, L9\_H9) and name-mover (L10\_H0)---3 of 7 known classes. Activation patching recovers 4/7. (b) Threshold sensitivity: edge density drops smoothly as $\tau $ increases, while correlation peaks at $\tau =0.3$.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:gpt2}{{5}{8}{\textbf {GPT-2 Small results.} (a) IOI component recovery: zero-query score recovers duplicate-token heads (L8\_H0, L9\_H6, L9\_H9) and name-mover (L10\_H0)---3 of 7 known classes. Activation patching recovers 4/7. (b) Threshold sensitivity: edge density drops smoothly as $\tau $ increases, while correlation peaks at $\tau =0.3$}{figure.caption.8}{}}
\citation{bricken2023towards,templeton2024scaling,marks2024sparse}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Ablation Analysis}{9}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Ablation analysis.} Each bar removes one component from the full GNOmE pipeline. Graph structure is necessary (random features collapse to $r \approx 0$), cross-layer edges carry critical circuit signal ($-42\%$), and the 2-layer GNN captures diminishing returns beyond 2 hops.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ablation}{{6}{9}{\textbf {Ablation analysis.} Each bar removes one component from the full GNOmE pipeline. Graph structure is necessary (random features collapse to $r \approx 0$), cross-layer edges carry critical circuit signal ($-42\%$), and the 2-layer GNN captures diminishing returns beyond 2 hops}{figure.caption.9}{}}
