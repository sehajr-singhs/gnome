\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Convergent discovery timeline.} GNOmE and Anthropic's Circuit Tracing independently discovered that neural network computation is best understood as a graph. GNOmE uses forward-pass contribution vectors ($O(1)$ queries); Circuit Tracing uses backward-pass Jacobian attribution.}}{10}{figure.caption.10}\protected@file@percent }
