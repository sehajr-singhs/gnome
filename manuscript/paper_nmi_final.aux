\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Cross-task generalization of GNOmE importance ranking.} Spearman $\rho $ and Pearson $r$ with zero-ablation ground truth across four behavioral tasks. GNOmE performs best on IOI ($\rho = 0.426$), the most well-characterized circuit. The positive mean ($\rho = 0.155$) across all tasks confirms that weight norms capture general structural importance.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:transfer}{{6}{10}{\textbf {Cross-task generalization of GNOmE importance ranking.} Spearman $\rho $ and Pearson $r$ with zero-ablation ground truth across four behavioral tasks. GNOmE performs best on IOI ($\rho = 0.426$), the most well-characterized circuit. The positive mean ($\rho = 0.155$) across all tasks confirms that weight norms capture general structural importance}{figure.6}{}}
